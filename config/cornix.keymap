/*
 * 2026-05-23: Replaced upstream's complex 8-layer keymap (custom homerow
 * mods, combos, conditional_layers, Win / Adjust / Navi / NumPad / Debug
 * layers) with a slim 4-layer default matching the day-to-day ZMK Studio
 * working state. Intent: a fresh flash or settings reset (cornix_reset.uf2)
 * should land close to actual usage, not the upstream author's untouched
 * setup.
 *
 * 2026-06-02: Re-synced the per-layer `bindings` to the live ZMK Studio
 * working state, captured via the keymap export from zmk-studio-tweaks
 * (Cornix-2026-06-02T14-47-56.keymap). Notable changes vs the 2026-05-23
 * default: Bluetooth keys consolidated onto the Symbols layer only (removed
 * from Number/Functions), the Base-layer right-pinky `!`/`?` dropped to
 * &none, and several JIS symbol slots on Number/Symbols remapped. After a
 * reset, a fresh flash now lands on this exact working state.
 *
 * ZMK Studio interaction:
 *   - Studio overrides per-layer `bindings` via NVS at runtime; the
 *     `bindings` here are the post-reset / pre-Studio-edit defaults.
 *   - Studio does NOT cover `sensor-bindings` (encoders), combos,
 *     behaviors, conditional_layers or macros — those keep being
 *     controlled by this file at runtime regardless of Studio state.
 *     The Studio export omits sensor-bindings, so they are preserved
 *     here by hand.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <behaviors/naginata.dtsi>

#define JP_CARET EQUAL        // ^
#define JP_YEN   INT3         // ¥
#define JP_AT    LBKT         // @
#define JP_LBKT  RBKT         // [
#define JP_RBKT  NUHS         // ]
#define JP_COLON SQT          // :
#define JP_SEMI  SEMI         // ;
#define JP_BSLH  INT1         // (backslash)
#define JP_EXCL  LS(N1)       // !
#define JP_DQT   LS(N2)       // "
#define JP_HASH  LS(N3)       // #
#define JP_DLLR  LS(N4)       // $
#define JP_PRCNT LS(N5)       // %
#define JP_AMPS  LS(N6)       // &
#define JP_SQT   LS(N7)       // '
#define JP_LPAR  LS(N8)       // (
#define JP_RPAR  LS(N9)       // )
#define JP_LBRC  LS(JP_LBKT)  // {
#define JP_RBRC  LS(JP_RBKT)  // }
#define JP_LT    LS(COMMA)    // <
#define JP_RT    LS(DOT)      // >
#define JP_EQUAL LS(MINUS)    // =
#define JP_PLUS  LS(SEMI)     // +
#define JP_ASTRK LS(JP_COLON) // *
#define JP_QMARK LS(SLASH)    // ?
#define JP_UNDER LS(JP_BSLH)  // _
#define JP_TILDE LS(JP_CARET) // ~
#define JP_PIPE  LS(JP_YEN)   // |
#define JP_GRAVE LS(JP_AT)    // `

/ {
    macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap &kp LANGUAGE_1
                 &to 1>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap &kp LANGUAGE_2
                 &to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <18 19>;
            bindings = <&ng_on>;
            layers = <0>;
        };

        combo_ng_off {
            timeout-ms = <300>;
            key-positions = <16 17>;
            bindings = <&ng_off>;
            layers = <0 1>;
        };
    };

    behaviors {
        zero_at: zero_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp 0>, <&kp JP_AT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T                                              &kp Y            &kp U            &kp I            &kp O            &kp P            &kp JP_AT
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &mt LCTL GRAVE   &kp A            &kp S            &kp D            &kp F            &kp G                                              &kp H            &kp J            &kp K            &kp L            &kp MINUS        &kp FSLH
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B            &none            &none            &kp N            &kp M            &kp COMMA        &kp DOT          &kp UP           &kp BSLH
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp LCTL         &kp LGUI         &kp LALT         &lt 4 TAB        &lt 3 ESC        &kp SPACE                                          &kp ENTER        &kp BACKSPACE    &tog 2           &kp LEFT         &kp DOWN         &kp RIGHT
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

    Naginata {
            display-name = "Naginata";
            bindings = <
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &ng F15          &ng Q            &ng W            &ng E            &ng R            &ng T                                              &ng Y            &ng U            &ng I            &ng O            &ng P            &kp BSPC
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &mt LCTL GRAVE   &ng A            &ng S            &ng D            &ng F            &ng G                                              &ng H            &ng J            &ng K            &ng L            &ng SEMI         &kp ENTER
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp LSHFT        &ng Z            &ng X            &ng C            &ng V            &ng B            &none            &none            &ng N            &ng M            &ng COMMA        &ng DOT          &ng SLASH        &lt 4 JP_AT
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp LCTL         &kp LGUI         &kp LALT         &mo 4            &lt 3 ESC        &ng SPACE                                          &ng ENTER        &ng SPACE        &mo 3            &kp LEFT         &kp DOWN         &kp RIGHT
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Onishi {
            display-name = "Onishi";
            bindings = <
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp TAB          &kp Q            &kp L            &kp U            &kp COMMA        &kp DOT                                            &kp F            &kp W            &kp R            &kp Y            &kp P            &kp BSPC
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &mt LCTL GRAVE   &kp E            &kp I            &kp A            &kp O            &kp MINUS                                          &kp K            &kp T            &kp N            &kp S            &kp H            &kp ENTER
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp SEMI         &none            &none            &kp G            &kp D            &kp M            &kp J            &kp B            &kp RSHFT
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &kp LCTL         &kp LGUI         &kp LALT         &mo 4            &lt 3 ESC        &kp SPACE                                          &kp ENTER        &kp BACKSPACE    &tog 2           &kp NUBS         &kp FSLH         &kp BSLH
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Number {
            display-name = "Number";
            bindings = <
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &none            &kp N1           &kp N2           &kp N3           &kp N4           &kp N5                                             &kp N6           &kp N7           &kp N8           &kp N9           &kp JP_LBKT      &kp JP_RBKT
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &none            &kp QUESTION     &kp JP_UNDER     &kp JP_ASTRK     &kp LSHFT        &kp JP_EQUAL                                       &kp JP_PIPE      &kp N4           &kp N5           &kp N6           &kp JP_COLON     &kp JP_SEMI
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &none            &kp JP_CARET     &kp JP_GRAVE     &kp MINUS        &kp JP_PLUS      &kp JP_TILDE     &none            &none            &zero_at         &kp N1           &kp N2           &kp N3           &kp SLASH        &kp JP_BSLH
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &none            &none            &none            &none            &none            &none                                              &kp none         &kp DOT          &kp COMMA        &kp JP_YEN       &kp JP_LBRC      &kp JP_RBRC
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Functions {
            display-name = "Functions";
            bindings = <
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &none            &none            &kp F1           &kp F2           &kp F3           &kp F4                                             &none            &none            &kp UP           &none            &none            &none
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &bt BT_SEL 0     &none            &kp F5           &kp F6           &kp F7           &kp F8                                             &none            &kp LEFT         &kp DOWN         &kp RIGHT        &none            &none
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &bt BT_SEL 1     &none            &kp F9           &kp 10           &kp 11           &kp F12          &none            &none            &none            &none            &none            &none            &none            &none
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
    &bt BT_SEL 2     &none            &none            &none            &none            &none                                              &none            &none            &none            &none            &none            &bt BT_CLR
// +----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+----------------+
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
